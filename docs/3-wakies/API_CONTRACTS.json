{
  "description": "Extraction AST du code exécuté : expressions de réponses et schémas exacts. Les types des requêtes importées restent définis dans lib/wakies ; ceci ne remplace pas un test HTTP réel.",
  "routes": [
    {
      "file": "app/(chat)/api/wakies/chat/route.ts",
      "schemas": [
        {
          "name": "schema",
          "definition": "z .object({ conversationId: z.string().uuid(), messages: z.array(z.unknown()).min(1).max(200), sourceUrl: z.string().max(500).optional(), }) .passthrough()"
        }
      ],
      "handlers": [
        {
          "method": "POST",
          "authentication": ["authenticateChatRequest"],
          "guards": [
            "rejectCrossOriginMutation(request)",
            "findConversation(auth.userId, conversationId)",
            "findWakie(auth.userId, conversation.wakieId)",
            "reserveChatTurn( auth.userId, conversationId, dernier.id )"
          ],
          "validation": [
            "schema.safeParse(await request.json().catch(() => null))",
            "incomingUserMessage.safeParse(parsed.data.messages.at(-1))"
          ],
          "responses": [
            {
              "factory": "errorResponse",
              "arguments": ["\"access_denied\""]
            },
            {
              "factory": "errorResponse",
              "arguments": ["\"auth_required\""]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"plan_required\"",
                "{ details: { upgradeUrl: MAI_UPGRADE_URL }, message: \"Wakies est disponible avec les forfaits mAI Plus, Pro et Max.\", }"
              ]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"invalid_request\"",
                "{ message: \"Requête de conversation invalide.\", }"
              ]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"quota_exceeded\"",
                "{ details: { limit: auth.maiUser.limit, resetAt: auth.maiUser.resetAt, used: auth.maiUser.tokensUsed, }, message: \"Votre limite hebdomadaire de tokens est atteinte. Un message envoyé à un Wakie la consomme comme un message du chat.\", }"
              ]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"not_found\"",
                "{ message: \"Conversation introuvable.\", }"
              ]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"access_denied\"",
                "{ message: \"Les Wakies sont en pause. Reactivez-les dans les réglages.\", }"
              ]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"not_found\"",
                "{ message: \"Wakie introuvable.\" }"
              ]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"invalid_request\"",
                "{ message: \"Envoyez un message utilisateur contenant du texte ou un fichier.\", }"
              ]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"access_denied\"",
                "{ message: \"Pièce jointe privée invalide pour ce compte.\", }"
              ]
            },
            {
              "factory": "Response.json",
              "arguments": [
                "{ code: \"turn_already_saved\", message: \"Ce message est déjà enregistré. Rouvrez la conversation pour retrouver la réponse.\", }",
                "{ status: 409 }"
              ]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"access_denied\"",
                "{ message: \"Ce modèle n’est pas disponible pour votre compte. Choisissez un modèle du catalogue mAI.\", }"
              ]
            },
            {
              "factory": "Response.json",
              "arguments": [
                "{ code: \"conversation_busy\", message: reservation.conflict === \"busy\" ? \"Une réponse est déjà en cours dans cette conversation. Réessayez après sa fin.\" : \"Ce tour a déjà été lancé. Rechargez l’historique avant un nouvel envoi.\", }",
                "{ status: 409 }"
              ]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"invalid_request\"",
                "{ message: error instanceof Error && error.name === \"WakiesAttachmentError\" ? error.message : \"Impossible de préparer la conversation. Réessayez dans quelques instants.\", }"
              ]
            },
            {
              "factory": "createUIMessageStreamResponse",
              "arguments": ["{ stream }"]
            }
          ]
        }
      ]
    },
    {
