    {
      "file": "app/(chat)/api/wakies/files/route.ts",
      "schemas": [
        {
          "name": "query",
          "definition": "z.object({ cursor: z.string().max(2048).optional(), pathname: z.string().max(512).optional(), })"
        },
        {
          "name": "removal",
          "definition": "z.object({ pathname: z.string().min(1).max(512) })"
        }
      ],
      "handlers": [
        {
          "method": "GET",
          "authentication": ["requireWakiesUser"],
          "guards": [
            "pathnameDuCompte(identity.userId, parsed.data.pathname)",
            "pathnameDuCompte(identity.userId, blob.pathname)"
          ],
          "validation": [
            "query.safeParse({ cursor: params.get(\"cursor\") ?? undefined, pathname: params.get(\"pathname\") ?? undefined, })"
          ],
          "responses": [
            {
              "factory": "errorResponse",
              "arguments": [
                "\"invalid_request\"",
                "{ message: \"Paramètres de fichiers invalides.\", }"
              ]
            },
            {
              "factory": "notFound",
              "arguments": ["\"Fichier introuvable.\""]
            },
            {
              "factory": "json",
              "arguments": [
                "{ mediaType: metadata.contentType, name: pathname.split(\"/\").at(-1) ?? \"Fichier\", pathname, size: metadata.size, url: await signerPieceJointe(identity.userId, pathname), }",
                "{ headers: { \"Cache-Control\": \"no-store\" } }"
              ]
            },
            {
              "factory": "json",
              "arguments": [
                "{ cursor: result.hasMore ? result.cursor : null, files: result.blobs .filter((blob) => pathnameDuCompte(identity.userId, blob.pathname)) .map((blob) => ({ name: blob.pathname.split(\"/\").at(-1) ?? \"Fichier\", pathname: blob.pathname, size: blob.size, uploadedAt: blob.uploadedAt.getTime(), })), }",
                "{ headers: { \"Cache-Control\": \"no-store\" } }"
              ]
            },
            {
              "factory": "notFound",
              "arguments": ["\"Fichier introuvable.\""]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"internal_error\"",
                "{ message: \"Le stockage de fichiers mAI est indisponible. Réessayez plus tard.\", }"
              ]
            }
          ]
        },
        {
          "method": "DELETE",
          "authentication": ["requireWakiesUser"],
          "guards": [
            "rejectCrossOriginMutation(request)",
            "pathnameDuCompte(identity.userId, parsed.data.pathname)"
          ],
          "validation": [
            "removal.safeParse(await request.json().catch(() => null))"
          ],
          "responses": [
            {
              "factory": "errorResponse",
              "arguments": [
                "\"invalid_request\"",
                "{ message: \"Fichier invalide.\" }"
              ]
            },
            {
              "factory": "notFound",
              "arguments": ["\"Fichier introuvable.\""]
            },
            {
              "factory": "json",
              "arguments": ["{ ok: true }"]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"internal_error\"",
                "{ message: \"Le fichier n’a pas pu être supprimé.\", }"
              ]
            }
          ]
        }
      ]
    },
