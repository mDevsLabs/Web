        {
          "method": "GET",
          "authentication": ["requireWakiesUser"],
          "guards": ["findConversation(identite.userId, id)"],
          "validation": [
            "QUERIES.safeParse({ avant: url.searchParams.get(\"avant\") ?? undefined, limite: url.searchParams.get(\"limite\") ?? undefined, })"
          ],
          "responses": [
            {
              "factory": "notFound",
              "arguments": ["\"Conversation introuvable.\""]
            },
            {
              "factory": "errorResponse",
              "arguments": [
                "\"invalid_request\"",
                "{ message: \"Curseur d’historique invalide.\", }"
              ]
            },
            {
              "factory": "json",
              "arguments": [
                "{ messages, // `null` quand la page rend le début de l'historique : rien à recharger. seqProchain: hasMore && premier ? premier.seq : null, }",
                "{ headers: { \"Cache-Control\": \"no-store\" } }"
              ]
            }
          ]
        }
      ]
    },
