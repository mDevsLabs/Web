{
  "model": "Supplier",
  "config": {
    "name": "Supplier",
    "label": "Fournisseurs",
    "description": "Gérez vos fournisseurs depuis une interface claire.",
    "fields": [
      {
        "key": "name",
        "label": "Nom",
        "kind": "text",
        "required": true
      },
      {
        "key": "contactEmail",
        "label": "E-mail",
        "kind": "email",
        "required": true
      },
      {
        "key": "leadTimeDays",
        "label": "Délai (jours)",
        "kind": "number",
        "required": true
      },
      {
        "key": "country",
        "label": "Pays",
        "kind": "text",
        "required": true
      },
      {
        "key": "status",
        "label": "Statut",
        "kind": "status",
        "required": true,
        "options": [
          "active",
          "pending",
          "inactive"
        ]
      }
    ],
    "titleKey": "name",
    "settings": [
      {
        "key": "notifySupplier",
        "label": "Notifications : fournisseurs",
        "description": "Recevoir un signal lors des changements."
      },
      {
        "key": "archiveSupplier",
        "label": "Archivage automatique",
        "description": "Archiver les éléments terminés de la section fournisseurs."
      },
      {
        "key": "approveSupplier",
        "label": "Validation requise",
        "description": "Demander une validation avant publication ou activation."
      }
    ]
  },
  "sample": {
    "id": "supplier-demo-1",
    "name": "Atelier Nord",
    "contactEmail": "bonjour@example.com",
    "leadTimeDays": 128,
    "country": "France",
    "status": "active"
  }
}
