{
  "model": "Recipe",
  "config": {
    "name": "Recipe",
    "label": "Recettes",
    "description": "Gérez vos recettes depuis une interface claire.",
    "fields": [
      {
        "key": "title",
        "label": "Titre",
        "kind": "text",
        "required": true
      },
      {
        "key": "author",
        "label": "Auteur",
        "kind": "text",
        "required": true
      },
      {
        "key": "prepMinutes",
        "label": "Préparation (min)",
        "kind": "number",
        "required": true
      },
      {
        "key": "servings",
        "label": "Portions",
        "kind": "number",
        "required": true
      },
      {
        "key": "status",
        "label": "Statut",
        "kind": "status",
        "required": true,
        "options": [
          "draft",
          "published",
          "archived"
        ]
      }
    ],
    "titleKey": "title",
    "settings": [
      {
        "key": "notifyRecipe",
        "label": "Notifications : recettes",
        "description": "Recevoir un signal lors des changements."
      },
      {
        "key": "archiveRecipe",
        "label": "Archivage automatique",
        "description": "Archiver les éléments terminés de la section recettes."
      },
      {
        "key": "approveRecipe",
        "label": "Validation requise",
        "description": "Demander une validation avant publication ou activation."
      }
    ]
  },
  "sample": {
    "id": "recipe-demo-1",
    "title": "Risotto aux champignons",
