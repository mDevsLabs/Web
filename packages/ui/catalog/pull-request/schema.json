{
  "model": "PullRequest",
  "config": {
    "name": "PullRequest",
    "label": "Demandes de fusion",
    "description": "Gérez vos demandes de fusion depuis une interface claire.",
    "fields": [
      {
        "key": "title",
        "label": "Titre",
        "kind": "text",
        "required": true
      },
      {
        "key": "author",
        "label": "Auteur",
        "kind": "text",
        "required": true
      },
      {
        "key": "number",
        "label": "Numéro",
        "kind": "number",
        "required": true
      },
      {
        "key": "changedFiles",
        "label": "Fichiers modifiés",
        "kind": "number",
        "required": true
      },
      {
        "key": "status",
        "label": "Statut",
        "kind": "status",
        "required": true,
        "options": [
          "open",
          "review",
          "merged",
          "closed"
        ]
      }
    ],
    "titleKey": "title",
    "settings": [
      {
        "key": "notifyPullRequest",
        "label": "Notifications : demandes de fusion",
        "description": "Recevoir un signal lors des changements."
      },
      {
        "key": "archivePullRequest",
        "label": "Archivage automatique",
        "description": "Archiver les éléments terminés de la section demandes de fusion."
      },
      {
        "key": "approvePullRequest",
        "label": "Validation requise",
        "description": "Demander une validation avant publication ou activation."
      }
    ]
  },
  "sample": {
    "id": "pull-request-demo-1",
    "title": "Ajouter les thèmes",
    "author": "Auteur démo",
    "number": 128,
    "changedFiles": 128,
    "status": "open"
  }
}
