{
  "model": "AccessToken",
  "config": {
    "name": "AccessToken",
    "label": "Jetons d’accès",
    "description": "Gérez vos jetons d’accès depuis une interface claire.",
    "fields": [
      {
        "key": "name",
        "label": "Nom",
        "kind": "text",
        "required": true
      },
      {
        "key": "owner",
        "label": "Propriétaire",
        "kind": "text",
        "required": true
      },
      {
        "key": "scope",
        "label": "Permissions",
        "kind": "text",
        "required": true
      },
      {
        "key": "expiresOn",
        "label": "Expiration",
        "kind": "date",
        "required": true
      },
      {
        "key": "status",
        "label": "Statut",
        "kind": "status",
        "required": true,
        "options": [
          "active",
          "expired",
          "revoked"
        ]
      }
    ],
    "titleKey": "name",
    "settings": [
      {
        "key": "notifyAccessToken",
        "label": "Notifications : jetons d’accès",
        "description": "Recevoir un signal lors des changements."
      },
      {
        "key": "archiveAccessToken",
        "label": "Archivage automatique",
        "description": "Archiver les éléments terminés de la section jetons d’accès."
      },
      {
        "key": "approveAccessToken",
        "label": "Validation requise",
        "description": "Demander une validation avant publication ou activation."
      }
    ]
  },
  "sample": {
    "id": "access-token-demo-1",
    "name": "Automatisation CI",
    "owner": "Marie Dupont",
    "scope": "Permissions démo",
    "expiresOn": "2026-10-04",
    "status": "active"
  }
}
