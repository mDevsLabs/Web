{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "includes": [
      "**/*",
      "!components/ai-elements",
      "!components/elements",
      "!components/ui",
      "!components/site/ui",
      "!lib/utils.ts",
      "!hooks/use-mobile.ts",
      "!scripts/newsletter_editor.html",
      "!lib/plugins/catalog.generated.ts",
      "!lib/plugins/server.generated.ts",
      // Feuille de style Vibe : sortie de scripts/build-vibe-css.mjs (source :
      // apps/vibe/src/index.css). Comme les catalogues générés ci-dessus, elle
      // n'est pas écrite à la main — la corriger ici serait perdu à la
      // prochaine génération.
      "!components/vibe/vibe.css",
      // Feuilles de style Wakies : sorties de scripts/build-wakies-css.mjs
      // (sources : apps/wakies/src/client/style.css et editor.css). Générées,
      // donc jamais écrites à la main — même règle que pour vibe.css.
      "!components/wakies/wakies.css",
      "!components/wakies/wakies-editor.css",
      // Feuille de style Site : sortie de scripts/build-site-css.mjs (source :
      // apps/site/app/globals.css). Générée, donc jamais écrite à la main.
      "!components/site/site.css",
      // Sources Vibe d'origine (app Vite) : conservées uniquement comme
      // référence de génération (feuille de style, ordre des tables de
      // réglages) et de comparaison. Ni compilées par Next ni typées
      // (tsconfig.json les exclut), et elles ont leur propre linter (oxlint).
      // Sources d'applications autonomes et paquets externes :
      // Exclus pour ne pas polluer le linting du projet principal mAI Web.
      "!apps",
      "!packages"
    ]
  },
  // Vibe : les tables de réglages (thèmes de bulles, fonds de discussion, formes,
  // palette d'accent, tailles de texte) sont itérées telles quelles par
  // l'interface — `Object.keys`/`Object.values` côté réglages et page Messages.
  // Leur ORDRE de clés est donc l'ordre d'affichage des options : l'assist
  // `useSortedKeys` les alphabétiserait et changerait cet ordre (le thème par
  // défaut ne serait plus le premier). Désactivé pour ce seul fichier.
  "overrides": [
    // Vibe (porté de l'app Vite) : plusieurs tableaux de dépendances sont des
    // DÉCLENCHEURS volontaires — `[post.id, post.poll]` resynchronise un post
    // rechargé, `[resetKey]` relance un fil, `[nonce]` force un refetch,
    // `[messages]` défile en bas, `[current]` réapplique la vitesse. Ces valeurs
    // ne sont pas lues par l'effet : Biome les voit comme « inutiles » et
    // proposerait de les retirer, ce qui supprimerait le déclenchement. On
    // désactive ce signalement pour le code porté — jamais celui des
    // dépendances MANQUANTES, qui reste actif (elles sont corrigées).
    {
      "includes": ["components/vibe/**", "lib/vibe/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": {
              "level": "error",
              "options": {
                "reportUnnecessaryDependencies": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/lib/vibe/context/ThemeContext.tsx"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      }
    },
    // Wakies (porté de l'app Vite) : mêmes déclencheurs volontaires que Vibe —
    // `[thread.id]` recharge un fil, `[selectedThread]` suit la conversation
    // ouverte, `[messages]` colle le fil en bas, `[hash]` reprend la navigation
    // par fragment. Le signalement « dépendance inutile » est donc coupé sur le
    // code porté ; celui des dépendances MANQUANTES reste actif.
    {
      "includes": ["components/wakies/**", "lib/wakies/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": {
              "level": "error",
              "options": {
                "reportUnnecessaryDependencies": false
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "components/site/**",
        "lib/site/**",
        "app/(chat)/site/**",
        "app/(chat)/api/site/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useOptionalChain": "off",
            "noUselessCatchBinding": "off",
            "useLiteralKeys": "off",
            "noRedundantDefaultExport": "off",
            "noUselessTernary": "off"
          },
          "style": {
            "useNodejsImportProtocol": "off",
            "useTemplate": "off",
            "useForOf": "off",
            "useCollapsedElseIf": "off"
          },
          "suspicious": {
            "noGlobalIsNan": "off",
            "noEvolvingTypes": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": {
              "level": "error",
              "options": {
                "reportUnnecessaryDependencies": false
              }
            }
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "off",
        "noUnknownAtRules": "off",
        "noConsole": "off",
        "noBitwiseOperators": "off",
        "noUnnecessaryConditions": "off",
        "noEmptyBlockStatements": "off",
        "noShadow": "off",
        "useAwait": "off",
        "noLeakedRender": "off",
        "noArrayIndexKey": "off",
        "noAlert": "off",
        "noDuplicateElseIf": "off",
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off",
        "noReturnAssign": "off",
        "noDocumentCookie": "off",
        "noNestedPromises": "off",
        "useErrorMessage": "off"
      },
      "style": {
        "noMagicNumbers": "off",
        "noNestedTernary": "off",
        "useConsistentTypeDefinitions": "off",
        "useDestructuring": "off",
        "noNonNullAssertion": "off",
        "noIncrementDecrement": "off",
        "useBlockStatements": "off",
        "noParameterAssign": "off",
        "noExportedImports": "off",
        "useDefaultSwitchClause": "off",
        "noSubstr": "off",
        "useCollapsedIf": "off",
        "useErrorCause": "off",
        "useFilenamingConvention": "off",
        "useConsistentMemberAccessibility": "off",
        "noCommonJs": "off"
      },
      "nursery": {
        "useSortedClasses": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "useSimplifiedLogicExpression": "off",
        "noVoid": "off",
        "noForEach": "off",
        "noStaticOnlyClass": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useButtonType": "off",
        "noLabelWithoutControl": "off",
        "useMediaCaption": "off",
        "noStaticElementInteractions": "off",
        "noNoninteractiveElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useAriaPropsSupportedByRole": "off",
        "noAriaHiddenOnFocusable": "off",
        "useIframeTitle": "off"
      },
      "correctness": {
        "useUniqueElementIds": "off",
        "useImageSize": "off",
        "noUndeclaredVariables": "off",
        "noUnusedVariables": "off",
        "noUnusedImports": "off",
        "useHookAtTopLevel": "off",
        "noUnusedFunctionParameters": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "useTopLevelRegex": "off",
        "noJsxPropsBind": "off",
        "noAwaitInLoops": "off",
        "noAccumulatingSpread": "off",
        "noDelete": "off",
        "noImgElement": "off",
        "noSyncScripts": "off",
        "noNamespaceImport": "off"
      }
    }
  }
}
