    "check:migrations": "deno check --allow-import lib/db/migrator.ts",
    "preview": "vite preview",
    "migrate": "node scripts/migrate.js",
    "migrate:ci": "node scripts/migrate.js"
  },
  "dependencies": {
    "@mdevs/icons": "file:../../packages/icons",
    "@mdevs/ui": "file:../../packages/ui",
    "@neondatabase/serverless": "^1.2.1",
    "dompurify": "^3.5.0",
    "driver.js": "^1.14.0",
    "framer-motion": "^14.14.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-mark": "^4.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "nodemailer": "^10.6.1",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
