# ============================================================================
# VIBE SOCIAL PLATFORM — Variables d'environnement (MODÈLE)
# Copiez ce fichier en .env et remplissez les valeurs réelles
# ⚠️ NE JAMAIS COMMITTER .env — uniquement .env.example
# ============================================================================

# ─── Base de données Neon PostgreSQL ─────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"
PGHOST="your-host.neon.tech"
PGUSER="neondb_owner"
PGPASSWORD="your_password"
PGDATABASE="neondb"

# ─── JWT & Authentification ───────────────────────────────────────────────────
MAI_JWT_SECRET="your_jwt_secret_min_32_chars"
# Repli lu par config.ts uniquement si MAI_JWT_SECRET est vide.
JWT_SECRET=""
# Proxys de confiance pour X-Forwarded-For / X-Real-IP (laisser vide
# si le runtime ne fournit pas d'adresse pair fiable).
TRUSTED_PROXY_CIDRS=""
KEY_VAULTS_SECRET="your_vault_secret"
# Facultatif : hash bcrypt privé qui active explicitement le seed @bot.
# Sans valeur, aucun compte @bot n'est créé et tout ancien hash est neutralisé.
BOT_PASSWORD_HASH=""

# ─── API Keys IA ─────────────────────────────────────────────────────────────
MAI_API_KEY="mp-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
COMET_API_KEY=""

# ─── Traduction DeepL (clé 2 = secours si la 1re échoue) ─────────────────────
# Les clés gratuites se terminent par « :fx » (routage api-free automatique)
DEEPL_API_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx"
DEEPL_API_KEY_2=""

# ─── Stockage S3 (Cloudflare R2 ou S3 compatible) ───────────────────────────
S3_ACCESS_KEY_ID="your_s3_key"
S3_SECRET_ACCESS_KEY="your_s3_secret"
S3_BUCKET="your-bucket-name"
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_PUBLIC_URL="https://your-bucket.r2.dev"

# ─── Email (Gmail App Password) ──────────────────────────────────────────────
GMAIL_USER="your@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ─── API Externes ─────────────────────────────────────────────────────────────
YOU_API_KEY="ydc-sk-xxxxxxxxxxxxxxxxxxxx"
# URL de l'application Capacitor (configurée par capacitor.config.ts).
VIBE_WEB_URL="https://mai-vibe.vercel.app"
