{
  "name": "blackline-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "BLACKLINE, jeu tactique embarqu\u00e9 hors ligne",
  "author": "BLACKLINE",
  "main": "main.cjs",
  "scripts": {
    "prepare:web": "node ../../scripts/native/prepare-desktop.mjs",
    "start": "electron .",
    "package": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.blackline.horizon",
    "productName": "BLACKLINE",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "protocol-path.cjs",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": null,
      "icon": "../assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "../assets/icon.png"
    }
  }
}
