import './theme.css';
import { bindNativeEvents, mountBlackline } from './entry.ts';

// L'application autonome : elle possède le document. La racine du jeu est
// `<html>` — la feuille de style d'origine s'y applique telle quelle, et
// l'hôte mAI, qui monte le jeu dans un conteneur `.blackline-root`, obtient
// la même API sans que ce fichier change.
//
// Le point d'entrée est importé DYNAMIQUEMENT après le CSS : le moteur
// (`three-core`, 522 Ko) ne doit pas être dans le graphe initial. Voir
// `scripts/check-bundle.mjs`.
void (async () => {
  const ui = await mountBlackline();
  if (ui) {
    bindNativeEvents(ui);
  }
})();
