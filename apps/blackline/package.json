{
  "name": "@mdevs/blackline",
  "version": "0.9.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "export": "node scripts/export-project.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.ts tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "three": "0.187.0",
    "@neondatabase/serverless": "1.2.1"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "vite": "8.3.8",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  }
}
