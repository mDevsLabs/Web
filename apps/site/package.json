    "reset:images": "../../node_modules/.bin/tsx ../../scripts/admin.ts --reset-images",
    "reset:all": "../../node_modules/.bin/tsx ../../scripts/admin.ts --reset-all",
    "reset:audio": "../../node_modules/.bin/tsx ../../scripts/admin.ts --reset-audio",
