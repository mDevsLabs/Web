{
  "name": "@mdevs/mai",
  "version": "1.1.5",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint app components lib tests vitest.config.ts --no-error-on-unmatched-pattern",
    "lint:all": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:valtown": "tsc --project tsconfig.valtown.json --noEmit",
    "setup": "npm install",
    "reset:api": "bun run scripts/admin.ts --reset-api",
    "reset:mai": "bun run scripts/admin.ts --reset-mai",
    "reset:images": "bun run scripts/admin.ts --reset-images",
    "reset:all": "bun run scripts/admin.ts --reset-all",
    "reset:audio": "bun run scripts/admin.ts --reset-audio",
    "admin": "bun run scripts/admin.ts",
    "newsletter:send": "bun run scripts/newsletter-send.ts",
    "code:create": "bun run scripts/admin.ts --codes"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "16.3.8",
    "nodemailer": "^9.1.1",
    "react": "^19.3.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-use": "^17.6.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
