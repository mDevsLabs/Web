{
  "name": "wakies",
  "version": "0.9.0",
  "description": "A self-hosted personal-agent template with CopilotKit Intelligence, Threads, and Channels.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "concurrently -k \"NODE_ENV=development node --env-file-if-exists=.env --import tsx --watch src/server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "browser": "node --env-file-if-exists=.env --import tsx src/browser/index.ts",
    "browser:start": "node --env-file-if-exists=.env dist/server/browser/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts",
    "format": "prettier --write src tests *.json *.ts *.js index.html public .github Dockerfile \"compose*.yml\" deployment README.md docs .env.example --ignore-unknown",
    "check-format": "prettier --check src tests *.json *.ts *.js index.html public .github Dockerfile \"compose*.yml\" deployment README.md docs .env.example --ignore-unknown"
  },
  "keywords": [],
  "author": "mDevsLabs",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@ag-ui/client": "^0.0.59",
    "@ag-ui/core": "^0.0.59",
    "@copilotkit/channels": "^0.11.0",
    "@copilotkit/core": "^1.77.0",
    "@copilotkit/react-core": "^1.77.0",
    "@copilotkit/runtime": "^1.77.0",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/ai": "^0.64.1",
    "@tanstack/ai-openai": "^0.26.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CopilotKit/Wakies.git"
  },
  "overrides": {
    "undici": "^6.29.0"
  }
}
