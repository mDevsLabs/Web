{
  "name": "@mdevs/web",
  "version": "0.9.5",
  "private": true,
  "scripts": {
    "admin": "tsx scripts/admin.ts",
    "build": "node scripts/validate-site-news.mjs && node scripts/build-vibe-css.mjs && node scripts/build-wakies-css.mjs && node scripts/build-site-css.mjs && node scripts/build-blackline.mjs && node scripts/build-blackline-css.mjs && node scripts/build-next.mjs",
    "build:all": "pnpm run build && pnpm --dir apps/coder run build && pnpm --dir apps/desktop run build",
    "build:blackline": "node scripts/build-blackline.mjs && node scripts/build-blackline-css.mjs",
    "build:coder": "pnpm --dir apps/coder run build",
    "build:coder:main": "pnpm --dir apps/coder run build:main",
    "build:coder:renderer": "pnpm --dir apps/coder run build:renderer",
    "build:limited": "node scripts/run-with-memory-limit.mjs 3072 node scripts/build-next.mjs",
    "build:site-css": "node scripts/build-site-css.mjs",
    "check": "ultracite check",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm exec tsx lib/db/migrate.ts",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:up": "drizzle-kit up",
    "desktop:build": "pnpm --dir apps/desktop run build",
    "desktop:dev": "pnpm --dir apps/desktop run dev",
    "dev": "node scripts/dev.mjs",
    "dev:coder": "pnpm --dir apps/coder run dev",
    "fix": "ultracite fix",
    "optimizer:check": "tsx scripts/optimizer.ts --ci",
    "optimizer:report": "tsx scripts/optimizer.ts --report",
    "plugins:check": "tsx scripts/validate-plugins.ts",
    "plugins:gen": "tsx scripts/gen-plugin-catalog.ts",
    "prepare": "husky",
    "start": "next start",
    "test": "cross-env PLAYWRIGHT=True playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "tsc -p tsconfig.backend.json"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc,css}": "node node_modules/@biomejs/biome/bin/biome check --write --files-ignore-unknown=true"
