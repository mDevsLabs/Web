.vercel/*
.vercel
node_modules*
.next
.next/*
.agents
.agents/*
.env*
!.env.example

# Outil de debug local : forge un JWT signé avec le vrai MAI_JWT_SECRET.
# Injoignable depuis l'application (ni route, ni import), mais c'est une
# primitive de forgerie d'authentification complète : elle ne doit pas être
# versionnée. Le fichier reste utilisable en local après `git rm --cached`.
tests/debug/

# `.env.example` est versionné : c'est le contrat d'environnement du dépôt
# (`.env*` est ignoré, ce fichier fait exception ligne 9).
#
# Ces fichiers sont des variantes LOCALES du backend Val Town, et ils
# appartiennent à la RACINE du dépôt. Les motifs sont donc ANCRÉS (`/` initial) :
# un motif nu s'applique à TOUTE la profondeur, et il a déjà avalé le point
# d'entrée du jeu Blackline (`apps/blackline/src/main.ts`) — le fichier existait
# en local, le build Vite le résolvait, et la CI échouait sur un checkout
# propre. Un motif ancré ne peut plus rien avaler hors de la racine.
/main.ts
/main-projects.ts
/aiModels.ts
/maiModels.ts
/.neon

# AI Agent Docs
docs/AI_AGENTS_API.md
docs/llms-api.md
*.agent-doc.md

# Artefacts générés et journaux de débogage : jamais versionnés.
# (Ils étaient suivis et polluaient chaque revue : journaux d'exécution,
# rapports Playwright, cache d'incrémental TypeScript, identifiant local.)
.freebuff/project-id
.freebuff/*.log
dev-server.log
build.log
tsconfig.tsbuildinfo
*.tsbuildinfo
playwright-report/
test-results/
.sbom/
sbom.json

# Builds Electron Desktop
apps/coder/release/

# Jeu Blackline : artefacts de build servis par l'hôte sous /blackline.
# Sortie de `scripts/build-blackline.mjs` — reconstruite par `pnpm build`.
# (Comme pour vibe.css et wakies.css, la FEUILLE générée
# `components/blackline/blackline.css` est VERSIONNÉE : elle est importée par
# le build Next, qui ne compile pas le jeu.)
public/blackline/
apps/blackline/dist/
