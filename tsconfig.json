{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "electron": ["./tests/stubs/electron.ts"],
      "node-pty": ["./tests/stubs/node-pty.ts"]
    },
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "proxy.ts",
    ".next/types/**/*.ts",
    "next.config.ts",
    "drizzle.config.ts",
    "playwright.config.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    ".next/dev/types/**/*.ts"
  ],
  // Les copies du backend Val Town et sa CLI utilisent Deno/Bun, pas Next.js.
  // Les scripts Node de maintenance restent inclus dans le contrôle des types.
  "exclude": [
    "node_modules",
    "apps",
    "scripts/admin*.ts",
    "scripts/api-*.ts",
    "scripts/audio.ts",
    "scripts/auth.ts",
    "scripts/config.ts",
    "scripts/create-subscription-code.ts",
    "scripts/devices.ts",
    "scripts/email.ts",
    "scripts/images.ts",
    "scripts/main.ts",
    "scripts/mai-*.ts",
    "scripts/models*.ts",
    "scripts/openrouter-*.ts",
    "scripts/projects.ts",
    "scripts/realtime.ts",
    "scripts/storage.ts",
    "scripts/translate.ts",
    "scripts/updateModels.ts",
    "scripts/vibe*.ts",
    "scripts/web.ts"
  ]
}
