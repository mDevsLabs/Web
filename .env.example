# ============================================================================
# mAI Suite — Modèle Unique des Variables d'Environnement (.env.example)
#
# Copiez ce fichier en `.env.local` (ou `.env`) et renseignez les valeurs.
# AUCUNE valeur réelle ne doit être commitée : `.env*` est ignoré par Git.
#
# Ce fichier centralise la configuration des trois applications du dépôt :
#   1. mAI Web (Next.js 16 App Router & Backend Hono sur Val Town)
#   2. Vibe Social Platform (/vibe & apps/vibe)
#   3. Wakies Workspace (/wakies & apps/wakies)
# ============================================================================

# ============================================================================
# SECTION 1 — mAI Web (Application Principale & Backend Hono)
# ============================================================================

# ─── Base de données PostgreSQL (Neon) ──────────────────────────────────────
# Pooler pour le runtime Vercel, sans pooler pour drizzle-kit et les migrations.
# `?sslmode=require` est obligatoire côté Neon (cf. tests/unit/connection-string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
POSTGRES_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Connexion directe sans pooler pour les scripts de migration stricts :
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Permet de lire l'URL depuis un fichier chez les hébergeurs à secrets (Fly.io, Railway).
# DATABASE_URL_FILE="/run/secrets/DATABASE_URL"
# POSTGRES_URL_FILE="/run/secrets/POSTGRES_URL"

# DDL au runtime. DOIT rester désactivé : `lib/db/queries.ts` exécuterait du DDL
# à la volée, ce que la politique du dépôt interdit.
DB_RUNTIME_DDL_REPAIR="false"

# Échec du job de migration sur une étape non tolérée.
MIGRATIONS_STRICT="true"

# ─── Session et Authentification ────────────────────────────────────────────
# Secret HS256 de signature des jetons. DOIT être identique entre Next.js
# et le backend Val Town pour éviter tout verrouillage de session.
MAI_JWT_SECRET="votre_secret_jwt_min_32_caracteres"
# Repli historique :
# JWT_SECRET=""

# Claims `iss` / `aud`, vérifiés quand ils sont définis des deux côtés.
# MAI_JWT_ISSUER=""
# MAI_JWT_AUDIENCE=""

# Adresses email ayant droit au broadcast de notifications d'administration.
# MAI_ADMIN_EMAILS=""
# ADMIN_EMAILS=""

# ─── Backend Val Town ───────────────────────────────────────────────────────
MAI_API_URL="https://mai.val.run"
NEXT_PUBLIC_MAI_API_URL="https://mai.val.run"

# Origine autorisée par le client de fetch sûr côté serveur (safe-fetch).
# MAI_API_ORIGIN="https://mai.val.run"

# Clé système d'appel backend mAI.
MAI_API_KEY=""

# Secret des endpoints /api/cron/*. Fail-closed en production.
CRON_SECRET=""

# Codes de mise à niveau de forfait utilisateur (lus par config.ts).
# MAI_PLUS_CODE=""
# MAI_PRO_CODE=""
# MAI_MAX_CODE=""

# ─── Fournisseurs de Modèles d'IA & LLMs ────────────────────────────────────
OPENROUTER_API_KEY=""
# COMET_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""

# ─── Redis & Cache ─────────────────────────────────────────────────────────
# Rate limiting Chat/Agent, quotas d'auth et reprise de flux (resumable streams).
# REDIS_URL="rediss://..."

# ─── MCP (Model Context Protocol) ──────────────────────────────────────────
# Clé AES-256-GCM pour le chiffrement des secrets de serveurs MCP.
# Générer : openssl rand -base64 32
# MCP_ENCRYPTION_KEY=""
# MCP_ENCRYPTION_KEY_ID="primary"
# MCP_ENCRYPTION_PREVIOUS_KEYS="[]"
# MCP_ENCRYPTION_ALLOW_LEGACY_DERIVED_KEY="false"

# Exécution de serveurs MCP en sous-processus locaux (sécurité stricte).
# MCP_STDIO_ENABLED="false"
# MCP_STDIO_ALLOWED_COMMANDS=""
# MCP_STDIO_ALLOWED_ARGS=""
# MCP_STDIO_ALLOWED_ENV_KEYS=""

# ─── Stockage des Fichiers (S3 / Cloudflare R2 / Vercel Blob) ──────────────
# BLOB_READ_WRITE_TOKEN=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_PUBLIC_URL=""
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""

# ─── Emails & Notifications ─────────────────────────────────────────────────
# GMAIL_USER=""
# GMAIL_APP_PASSWORD=""
# GOOGLE_SCRIPTS_SECRET=""
# GOOGLE_SCRIPTS_URL=""

# ─── Plateforme & Sécurité ──────────────────────────────────────────────────
# NEXT_PUBLIC_BASE_PATH=""
# IS_DEMO="0"
# CSP_REPORT_ONLY="1"
# CHAT_OWNER_LEGACY_MATCH="false"
# AGENT_ENABLED="true"

# Contact affiché par les plugins publics (OpenAlex, Crossref…).
# PUBLIC_API_CONTACT_EMAIL=""
# GITHUB_PUBLIC_TOKEN=""


# ============================================================================
# SECTION 2 — Plateforme Sociale Vibe (/vibe & apps/vibe)
# ============================================================================

# ─── Traduction Instantanée DeepL ───────────────────────────────────────────
# Les clés gratuites se terminent par « :fx » (routage api-free automatique).
# Clé 2 = secours automatique en cas d'épuisement de quota.
# DEEPL_API_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx"
# DEEPL_API_KEY_2=""

# ─── Recherche Web Vibe & APIs Externes ─────────────────────────────────────
# YOU_API_KEY="ydc-sk-xxxxxxxxxxxxxxxxxxxx"
# YOU_API_KEY_2=""
# YOU_API_KEY_3=""

# ─── Sécurité Vibe, Proxys & Coffres-forts ──────────────────────────────────
# Clé secrète pour le coffre-fort de clés privées utilisateur (vault).
# KEY_VAULTS_SECRET=""

# CIDR des reverse-proxies de confiance pour la détection IP client (X-Forwarded-For).
# TRUSTED_PROXY_CIDRS=""

# Hash bcrypt privé facultatif pour instancier le compte système @bot.
# BOT_PASSWORD_HASH=""

# ─── Application Mobile Capacitor & Stockage Dédié ──────────────────────────
# URL distante chargée par la WebView Capacitor dans l'app mobile.
VIBE_WEB_URL="https://mai-vibe.vercel.app"

# Identifiants S3 dédiés aux uploads depuis l'application mobile :
# MOBILE_S3_ACCESS_KEY=""
# MOBILE_S3_SECRET_ACCESS_KEY=""


# ============================================================================
# SECTION 3 — Espace de Travail Wakies (/wakies & apps/wakies)
# ============================================================================
# Note : Dans mAI Web, le chat standard, la recherche Web (/v1/web/search)
# et la persistance multi-tenant PostgreSQL (16 tables Wakies*) sont
# nativement assurés par l'hôte sans configuration additionnelle.

# ─── Voix Temps Réel (OpenAI Realtime WebRTC) ──────────────────────────────
# VOICE_API_KEY=""
# VOICE_MODEL="gpt-realtime-2.1"
# VOICE_NAME="marin"

# ─── Ordinateurs Conteneurisés Persistants pour Wakies (OpenBot) ────────────
# Superviseur Docker gérant le cycle de vie des conteneurs de calcul individuels.
# COMPUTER_SUPERVISOR_URL="http://127.0.0.1:4312"
# COMPUTER_SUPERVISOR_TOKEN=""
# COMPUTER_TOKEN=""
# COMPUTER_NAMESPACE="wakies"
# COMPUTER_MEMORY_BYTES="2147483648"
# COMPUTER_RUNTIME="runsc"
# ENGINE_SOCKET="/var/run/docker.sock"

# ─── Intégration Slack (CopilotKit Channels SDK) ─────────────────────────────
# SLACK_CHANNEL_NAME=""
# SLACK_TEAM_ID=""
# SLACK_USER_IDS=""
# SLACK_WAKIE_ID=""

# ─── Worker Browser Isolé (Navigation Playwright en lecture seule) ──────────
# BROWSER_URL="http://127.0.0.1:4311"
# BROWSER_SECRET=""
# BROWSER_HOST="127.0.0.1"
# BROWSER_PORT="4311"

# ─── Variables de référence pour l'application autonome (apps/wakies/) ─────
# WAKIES_STANDALONE_HOST="127.0.0.1"
# WAKIES_STANDALONE_PORT="4310"
# WAKIES_STANDALONE_DATABASE_PATH="data/wakies.sqlite"
# OWNER_ID="wakies-owner"
# OWNER_TOKEN=""
# INTELLIGENCE_API_KEY=""
# WEB_SEARCH_PROVIDER="parallel"
# PARALLEL_API_KEY=""


# ============================================================================
# SECTION 4 — Éditeur mAI Coder (apps/coder)
# ============================================================================
