# Variables d'environnement de mAI Web.
#
# Copiez ce fichier en `.env.local` et renseignez les valeurs. AUCUNE valeur
# réelle ne doit être commitée : `.env*` est ignoré, à l'exception de ce
# fichier (`.gitignore` ligne 9).
#
# Le dépôt contient deux runtimes (cf. AGENTS.md §1) :
#   • l'application Next.js (app/, components/, lib/) lit les variables ci-dessous ;
#   • le backend Hono sur Val Town lit les siennes, dans un runtime Deno.
# Les variables marquées « backend » sont lues par ce second runtime.

# ─── Base de données (PostgreSQL) ───────────────────────────────────────────
# Pooler pour le runtime Vercel, sans pooler pour drizzle-kit et les migrations.
# `?sslmode=require` est obligatoire côté Neon (cf. tests/unit/connection-string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
POSTGRES_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Permet de lire l'URL depuis un fichier chez les hébergeurs à secrets
# (Fly.io, Railway). Prioritaire sur DATABASE_URL.
# DATABASE_URL_FILE="/run/secrets/DATABASE_URL"
# POSTGRES_URL_FILE="/run/secrets/POSTGRES_URL"

# DDL au runtime. DOIT rester désactivé : `lib/db/queries.ts` exécuterait du DDL
# à la volée, ce que la politique du dépôt interdit. Verrouillé par
# tests/unit/db-migration-safety.test.ts.
# DB_RUNTIME_DDL_REPAIR="false"

# Échec du job de migration sur une étape non tolérée. `false` ne devrait être
# utilisé que pour rattraper une base dont on connaît l'état exact.
# MIGRATIONS_STRICT="true"

# ─── Session et authentification ────────────────────────────────────────────
# Secret HS256 de la signature des jetons. DOIT être identique à celui du
# backend : une divergence rend le cookie présent mais la session illisible, et
# l'utilisateur se retrouve enfermé dans l'application (cf. AGENTS.md §9).
MAI_JWT_SECRET=""
# JWT_SECRET=""

# claims `iss` / `aud`, vérifiés quand ils sont définis des deux côtés.
# MAI_JWT_ISSUER=""
# MAI_JWT_AUDIENCE=""

# Adresses ayant droit au broadcast de notifications.
# MAI_ADMIN_EMAILS=""
# ADMIN_EMAILS=""

# ─── Backend Val Town ───────────────────────────────────────────────────────
MAI_API_URL="https://mai.val.run"
NEXT_PUBLIC_MAI_API_URL="https://mai.val.run"

# Origine autorisée par le client de fetch sûr côté serveur.
# MAI_API_ORIGIN="https://mai.val.run"

# Clé système d'appel backend. Sans elle ET sans jeton de session, les appels
# modèle échouent franchement : aucun repli sur une valeur partagée.
# MAI_API_KEY=""

# Secret des endpoints /api/cron/*. Fail-closed en production : sans lui, les
# deux routes refusent tout appel. Requis par .github/workflows/cron-agent.yml.
# CRON_SECRET=""

# Codes de mise à niveau de forfait, lus par config.ts.
# MAI_PLUS_CODE=""
# MAI_PRO_CODE=""
# MAI_MAX_CODE=""

# ─── Fournisseurs de modèles ────────────────────────────────────────────────
# OPENROUTER_API_KEY=""
# COMET_API_KEY=""

# ─── Redis ─────────────────────────────────────────────────────────────────
# Sans REDIS_URL, le rate limiting Chat/Agent est inactif hors production et les
# quotas d'authentification retombent sur un compteur mémoire borné.
# REDIS_URL="rediss://..."

# ─── MCP ───────────────────────────────────────────────────────────────────
# Clé AES-256-GCM des secrets de serveurs MCP, avec rotation par identifiant.
# Sans elle, l'enregistrement d'un secret MCP est refusé : aucun secret n'est
# jamais écrit en clair.
# Générer : openssl rand -base64 32
# MCP_ENCRYPTION_KEY=""
# MCP_ENCRYPTION_KEY_ID="primary"
# MCP_ENCRYPTION_PREVIOUS_KEYS="[]"

# Réactivation du dérivé legacy : rouvre précisément la faille que ce module
# corrige. Refusée en production ; ne jamais activer.
# MCP_ENCRYPTION_ALLOW_LEGACY_DERIVED_KEY="false"

# Exécution de serveurs MCP en sous-processus. Trois verrous cumulatifs :
# le drapeau, l'interpréteur interdit, et les listes blanches.
# MCP_STDIO_ENABLED="false"
# MCP_STDIO_ALLOWED_COMMANDS=""
# MCP_STDIO_ALLOWED_ARGS=""
# MCP_STDIO_ALLOWED_ENV_KEYS=""

# ─── Stockage des fichiers ──────────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET=""
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# MOBILE_S3_ACCESS_KEY=""
# MOBILE_S3_SECRET_ACCESS_KEY=""

# ─── Email et newsletter ────────────────────────────────────────────────────
# GMAIL_USER=""
# GMAIL_APP_PASSWORD=""
# GOOGLE_SCRIPTS_SECRET=""
# GOOGLE_SCRIPTS_URL=""

# ─── Plateforme ────────────────────────────────────────────────────────────
# Préfixe de chemin et d'assets lorsque l'application est servie sous un
# sous-répertoire (build de démonstration).
# NEXT_PUBLIC_BASE_PATH=""
# IS_DEMO="0"

# CSP en mode observation : `1` bascule l'en-tête en Report-Only le temps de
# mesurer, `0` applique la politique.
# CSP_REPORT_ONLY="1"

# Réconciliation d'identifiant pour les chats hérités. Le refus par défaut est
# volontaire : l'appartenance par courriel ouvrait une porte de prise de compte.
# CHAT_OWNER_LEGACY_MATCH="false"

# Kill switch de l'Agent.
# AGENT_ENABLED="true"

# ─── Tests ─────────────────────────────────────────────────────────────────
# À NE PAS poser localement : `isProductionEnvironment()` bascule dès qu'une de
# ces variables existe, ce qui change la branche du rate limiting et fait échouer
# les tests unitaires qui comptent sur son désactivation.
# PLAYWRIGHT_TEST_BASE_URL=""
# PLAYWRIGHT=""
# CI_PLAYWRIGHT=""

# ─── Plugins keyless ───────────────────────────────────────────────────────
# Contact affiché par les plugins publics (OpenAlex, Crossref…).
# PUBLIC_API_CONTACT_EMAIL=""

# Jeton public optionnel pour le plugin GitHub.
# GITHUB_PUBLIC_TOKEN=""