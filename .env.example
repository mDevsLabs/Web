# ASYNC_SHELL_OUTPUT_ENCODING=""
# ASYNC_LEGACY_TEXT_ENCODING=""
# ASYNC_BUILTIN_TEAM_SOURCE=""

# ─── Recherche Web You.com alternative & fallbacks ─────────────────────────
# YOU_API_KEY_1=""
# YDC_API_KEY=""

# ─── Notarisation macOS (compilation Release uniquement, jamais commité) ───
# APPLE_ID=""
# APPLE_APP_SPECIFIC_PASSWORD=""
# APPLE_TEAM_ID=""


